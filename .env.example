# Supabase (pre-populated for Bolt projects — do not change)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# The following secrets are set on the server (Supabase Edge Function secrets).
# They are NOT exposed to the client and should NOT be placed in this file.
# Set them via: supabase secrets set GEMINI_API_KEY=your-key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override the default model (defaults to gemma-4-26b-a4b-it)
# GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# --- Offline mode (Ollama) ---
# These are read by the Node.js backend (server/index.ts), NOT the browser.
# Set them in a .env file at the project root for local development.

# Ollama server URL (default: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# Ollama model name (default: gemma4:e2b)
OLLAMA_MODEL=gemma4:e2b

# Backend server port (default: 3001)
PORT=3001
